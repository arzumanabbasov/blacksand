# Docker deployment configuration: copy to .env.
# Compose builds Blacksand locally from this checkout.
BLACKSAND_LANGUAGE=en
POSTGRES_USER=blacksand
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=blacksand

# Set either/both LLM keys, or configure them later in the application.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
BLACKSAND_LLM_PROVIDER=
BLACKSAND_LLM_MODEL=
BLACKSAND_LLM_BASE_URL=
BLACKSAND_LLM_PROXY=

# Agent commands/code and workspace file tools: local (default) or e2b.
BLACKSAND_EXECUTION=local
E2B_API_KEY=
# Optional custom E2B template containing Python 3, bash, rg and your tools.
BLACKSAND_E2B_TEMPLATE=base
